# ─────────────────────────────────────────────────────────────
# priceteka-backend — production template (set these in the hosting panel)
# Read by: src/main.ts, src/app.module.ts, src/database/*.ts,
#          docker-compose.yml (POSTGRES_*)
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# HTTP port of the API
PORT=4000
# Frontends allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=https://YOUR-SITE-DOMAIN,https://YOUR-ADMIN-DOMAIN
# Number of proxies in front of the API (1 behind Render/Nginx). Empty locally.
TRUST_PROXY=1

# ── Docker Postgres (docker-compose.yml only) ────────────────
POSTGRES_DB=praisteka_dev
POSTGRES_USER=praisteka_dev
POSTGRES_PASSWORD=replace_with_a_long_random_password

# ── Database connection (API, migrations, admin:create) ──────
DB_HOST=YOUR-DB-HOST
# 5434 = host port of the local Docker DB (Billo uses 5433)
DB_PORT=5432
DB_USERNAME=YOUR-DB-USER
DB_PASSWORD=replace_with_a_long_random_password
DB_DATABASE=YOUR-DB-NAME
# true for hosted Postgres (Neon, RDS…), false for local Docker
DB_SSL=true

# ── First admin (used once by: npm run admin:create) ─────────
# Remove ADMIN_PASSWORD after the account is created.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
